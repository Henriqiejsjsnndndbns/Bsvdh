// ============================================================
// UTILITÁRIOS
// ============================================================

String jsonEscape(const String &input) {

    String out;

    out.reserve(input.length() + 20);

    for (size_t i = 0; i < input.length(); i++) {

        char c = input[i];

        switch (c) {

            case '\\':
                out += "\\\\";
                break;

            case '"':
                out += "\\\"";
                break;

            case '\n':
                out += "\\n";
                break;

            case '\r':
                out += "\\r";
                break;

            case '\t':
                out += "\\t";
                break;

            default:

                if ((uint8_t)c < 32) {
                    out += ' ';
                }
                else {
                    out += c;
                }

                break;

        }

    }

    return out;
}

// ============================================================
// NORMALIZAÇÃO DE PATH
// ============================================================

bool normalizePath(
    String input,
    String &output
) {

    input.trim();

    if (input.length() == 0)
        input = "/";

    input.replace("\\", "/");

    if (!input.startsWith("/"))
        input = "/" + input;

    if (input.indexOf('\0') >= 0)
        return false;

    String result = "";

    int start = 0;

    while (start < input.length()) {

        while (
            start < input.length() &&
            input[start] == '/'
        ) {
            start++;
        }

        if (start >= input.length())
            break;

        int end =
            input.indexOf('/', start);

        if (end < 0)
            end = input.length();

        String part =
            input.substring(start, end);

        if (part == "..")
            return false;

        if (part == ".") {

            start = end + 1;
            continue;

        }

        if (part.length() > 0) {

            result += "/";
            result += part;

        }

        start = end + 1;
    }

    if (result.length() == 0)
        result = "/";

    output = result;

    return true;
}

