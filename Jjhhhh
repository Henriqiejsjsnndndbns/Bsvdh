// ============================================================
// DETECÇÃO DO PENDRIVE
// ============================================================

void checkPendrive() {

    if (
        millis() - lastUSBCheck <
        200
    ) {
        return;
    }

    lastUSBCheck =
        millis();

    bool mounted =
        USBHostMSC.mounted();

    // --------------------------------------------------------
    // CONECTADO
    // --------------------------------------------------------

    if (
        mounted &&
        !pendriveMounted
    ) {

        pendriveMounted = true;

        Serial.println();
        Serial.println(
            "========================================"
        );

        Serial.println(
            "[USB] PENDRIVE DETECTADO"
        );

        Serial.printf(
            "[USB] Device address: %u\n",
            USBHostMSC.devAddr()
        );

        Serial.printf(
            "[USB] LUN: %u\n",
            USBHostMSC.lun()
        );

        Serial.printf(
            "[USB] Block size: %lu\n",
            (unsigned long)
            USBHostMSC.blockSize()
        );

        Serial.printf(
            "[USB] Block count: %lu\n",
            (unsigned long)
            USBHostMSC.blockCount()
        );

        Serial.println(
            "========================================"
        );

        // Aguarda o dispositivo ficar pronto.
        delay(100);

        if (
            USBMSCFS.begin(
                "/usb",
                8,
                false
            )
        ) {

            filesystemMounted = true;

            Serial.println(
                "[FS] Filesystem montado"
            );

            Serial.println(
                "[FS] Procurando arquivos..."
            );

            File root =
                USBMSCFS.open("/");

            if (root) {

                File f;

                while (
                    (f = root.openNextFile())
                ) {

                    Serial.printf(
                        "  %s %s %lu bytes\n",
                        f.isDirectory()
                            ? "[DIR]"
                            : "[FILE]",
                        f.name(),
                        (unsigned long)f.size()
                    );

                    f.close();
                }

                root.close();

            }

            Serial.println(
                "[FS] Listagem inicial concluída"
            );

        }
        else {

            filesystemMounted = false;

            Serial.println(
                "[FS] ERRO ao montar filesystem"
            );
        }
    }

    // --------------------------------------------------------
    // DESCONECTADO
    // --------------------------------------------------------

    if (
        !mounted &&
        pendriveMounted
    ) {

        Serial.println();
        Serial.println(
            "[USB] PENDRIVE DESCONECTADO"
        );

        pendriveMounted = false;

        if (filesystemMounted) {

            USBMSCFS.end();

            filesystemMounted = false;

            Serial.println(
                "[FS] Filesystem desmontado"
            );

        }
    }
}

// ============================================================
// WIFI
// ============================================================

void setupWiFi() {

    WiFi.mode(WIFI_AP);

    bool ok =
        WiFi.softAP(
            AP_SSID,
            AP_PASSWORD
        );

    if (!ok) {

        Serial.println(
            "[WIFI] Falha ao iniciar AP"
        );

        return;
    }

    IPAddress ip =
        WiFi.softAPIP();

    Serial.println();
    Serial.println(
        "========================================"
    );

    Serial.println(
        "[WIFI] ACCESS POINT"
    );

    Serial.printf(
        "[WIFI] SSID: %s\n",
        AP_SSID
    );

    Serial.printf(
        "[WIFI] IP: %s\n",
        ip.toString().c_str()
    );

    Serial.println(
        "[WIFI] Site: http://192.168.4.1/"
    );

    Serial.println(
        "========================================"
    );

    if (
        MDNS.begin("esp32usb")
    ) {

        MDNS.addService(
            "http",
            "tcp",
            80
        );

        Serial.println(
            "[MDNS] http://esp32usb.local/"
        );

    }
}

// ============================================================
// ROTAS HTTP
// ============================================================

void setupWebServer() {

    server.on(
        "/",
        HTTP_GET,
        handleRoot
    );

    server.on(
        "/api/status",
        HTTP_GET,
        handleStatus
    );

    server.on(
        "/api/list",
        HTTP_GET,
        handleList
    );

    server.on(
        "/api/download",
        HTTP_GET,
        handleDownload
    );

    server.on(
        "/api/view",
        HTTP_GET,
        handleView
    );

    server.on(
        "/api/save",
        HTTP_POST,
        handleSave
    );

    server.on(
        "/api/mkdir",
        HTTP_POST,
        handleMkdir
    );

    server.on(
        "/api/delete",
        HTTP_POST,
        handleDelete
    );

    server.on(
        "/api/upload",
        HTTP_POST,

        []() {

            if (!uploadAuthorized) {

                server.send(
                    401,
                    "text/plain",
                    "Autenticação de administrador necessária."
                );

                return;
            }

            server.send(
                200,
                "text/plain",
                "Upload concluído: " +
                uploadPath
            );

        },

        handleUpload
    );

    server.begin();

    Serial.println(
        "[WEB] Servidor iniciado na porta 80"
    );
}

