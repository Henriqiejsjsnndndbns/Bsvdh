    Serial.begin(115200);

    delay(1000);

    Serial.println();
    Serial.println(
        "################################################"
    );

    Serial.println(
        "# ESP32-S3 USB HOST + WEB FILE MANAGER"
    );

    Serial.println(
        "################################################"
    );

    Serial.printf(
        "Chip: %s\n",
        ESP.getChipModel()
    );

    Serial.printf(
        "Revision: %d\n",
        ESP.getChipRevision()
    );

    Serial.printf(
        "Flash: %u MB\n",
        ESP.getFlashChipSize() /
        (1024 * 1024)
    );

    Serial.printf(
        "PSRAM: %u MB\n",
        ESP.getPsramSize() /
        (1024 * 1024)
    );

    Serial.printf(
        "Heap: %u bytes\n",
        ESP.getFreeHeap()
    );

    // --------------------------------------------------------
    // WIFI
    // --------------------------------------------------------

    setupWiFi();

    // --------------------------------------------------------
    // WEB
    // --------------------------------------------------------

    setupWebServer();

    // --------------------------------------------------------
    // USB HOST
    // --------------------------------------------------------

    Serial.println();

    Serial.println(
        "[USB] Inicializando USB Host..."
    );

    usbHostStarted =
        USBHost.begin();

    if (usbHostStarted) {

        Serial.println(
            "[USB] USB Host iniciado"
        );

    }
    else {

        Serial.println(
            "[USB] FALHA ao iniciar USB Host"
        );

    }

    Serial.println();

    Serial.println(
        "Aguardando pendrive..."
    );
}

// ============================================================
// LOOP
// ============================================================

void loop() {

    // Mantém o stack USB Host ativo.
    USBHost.task();

    // Detecta conexão/desconexão.
    checkPendrive();

    // Processa HTTP.
    server.handleClient();

    delay(2);
}
