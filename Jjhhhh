void handleStatus() {

    if (!requireViewer())
        return;

    String json = "{";

    json += "\"usb_host\":";
    json += usbHostStarted ? "true" : "false";

    json += ",\"pendrive\":";
    json += pendriveMounted ? "true" : "false";

    json += ",\"filesystem\":";
    json += filesystemMounted ? "true" : "false";

    json += ",\"fstype\":\"FAT16/FAT32\"";

    json += ",\"total\":\"";

    if (filesystemMounted) {

        uint64_t total =
            USBMSCFS.totalBytes();

        uint64_t used =
            USBMSCFS.usedBytes();

        json += String(
            (double)used / (1024.0 * 1024.0),
            2
        );

        json += " MB usados de ";

        json += String(
            (double)total / (1024.0 * 1024.0),
            2
        );

        json += " MB";

    }
    else {

        json += "0 MB";

    }

    json += "\"";

    json += ",\"block_size\":";
    json += USBHostMSC.blockSize();

    json += ",\"block_count\":";
    json += USBHostMSC.blockCount();

    json += ",\"heap\":";
    json += ESP.getFreeHeap();

    json += ",\"psram\":";
    json += ESP.getFreePsram();

    json += "}";

    server.send(
        200,
        "application/json",
        json
    );
}

// ============================================================
// LISTAGEM
// ============================================================

void handleList() {

    if (!requireViewer())
        return;

    String path;

    if (!normalizePath(
            server.arg("path"),
            path
        )) {

        server.send(
            400,
            "application/json",
            "{\"ok\":false,\"error\":\"Path inválido\"}"
        );

        return;
    }

    File dir =
        USBMSCFS.open(path);

    if (!dir || !dir.isDirectory()) {

        server.send(
            404,
            "application/json",
            "{\"ok\":false,\"error\":\"Diretório não encontrado\"}"
        );

        return;
    }

    String parent = "/";

    if (path != "/") {

        int slash =
            path.lastIndexOf('/');

        if (slash <= 0)
            parent = "/";
        else
            parent =
                path.substring(0, slash);

    }

    String json;

    json.reserve(4096);

    json += "{";

    json += "\"ok\":true";
    json += ",\"path\":\"";
    json += jsonEscape(path);
    json += "\"";

    json += ",\"parent\":\"";
    json += jsonEscape(parent);
    json += "\"";

    json += ",\"items\":[";

    bool first = true;

    File file;

    while (
        (file = dir.openNextFile())
    ) {

        if (!first)
            json += ",";

        first = false;

        String name =
            String(file.name());

        bool isDir =
            file.isDirectory();

        String fullPath;

        if (path == "/")
            fullPath =
                "/" + name;
        else
            fullPath =
                path + "/" + name;

        json += "{";

        json += "\"name\":\"";
        json += jsonEscape(name);
        json += "\"";

        json += ",\"path\":\"";
        json += jsonEscape(fullPath);
        json += "\"";

        json += ",\"dir\":";
        json += isDir ? "true" : "false";

        json += ",\"size\":";
        json += (unsigned long)file.size();

        json += "}";

        file.close();
    }

    dir.close();

    json += "]";

    json += "}";

    server.send(
        200,
        "application/json",
        json
    );
}

// ============================================================
// DOWNLOAD
// ============================================================

void handleDownload() {

    if (!requireViewer())
        return;

    String path;

    if (!normalizePath(
            server.arg("path"),
            path
        )) {

        server.send(
            400,
            "text/plain",
            "Path inválido"
        );

        return;
    }

    File file =
        USBMSCFS.open(
            path,
            FILE_READ
        );

    if (!file || file.isDirectory()) {

        server.send(
            404,
            "text/plain",
            "Arquivo não encontrado"
        );

        return;
    }

    server.sendHeader(
        "Content-Disposition",
        "attachment; filename=\"" +
        String(file.name()) +
        "\""
    );

    server.streamFile(
        file,
        contentType(path)
    );

    file.close();
}

// ============================================================
// VISUALIZAR / EDITAR
// ============================================================

void handleView() {

    if (!requireViewer())
        return;

    String path;

    if (!normalizePath(
            server.arg("path"),
            path
        )) {

        server.send(
            400,
            "application/json",
            "{\"ok\":false,\"error\":\"Path inválido\"}"
        );

        return;
    }

    File file =
        USBMSCFS.open(
            path,
            FILE_READ
        );

    if (!file || file.isDirectory()) {

        server.send(
            404,
            "application/json",
            "{\"ok\":false,\"error\":\"Arquivo não encontrado\"}"
        );

        return;
    }

    size_t size =
        file.size();

    if (size > MAX_EDIT_BYTES) {

        file.close();

        server.send(
            413,
            "application/json",
            "{\"ok\":false,\"error\":\"Arquivo maior que o limite de edição de 64 KiB\"}"
        );

        return;
    }

    String content;

    content.reserve(size + 1);

    while (file.available()) {

        content +=
            (char)file.read();

    }

    file.close();

    String json;

    json.reserve(
        content.length() + 100
    );

    json += "{";

    json += "\"ok\":true,";

    json += "\"path\":\"";
    json += jsonEscape(path);
    json += "\",";

    json += "\"content\":\"";
    json += jsonEscape(content);
    json += "\"";

    json += "}";

    server.send(
        200,
        "application/json",
        json
    );
}

// ============================================================
// SALVAR
// ============================================================

void handleSave() {

    if (!requireAdmin())
        return;

    String path;

    if (!normalizePath(
            server.arg("path"),
            path
        )) {

        server.send(
            400,
            "application/json",
            "{\"ok\":false,\"error\":\"Path inválido\"}"
        );

        return;
    }

    String content =
        server.arg("plain");

    if (
        content.length() >
        MAX_EDIT_BYTES
    ) {

        server.send(
            413,
            "application/json",
            "{\"ok\":false,\"error\":\"Arquivo excede 64 KiB\"}"
        );

        return;
    }

    // Remove primeiro para evitar append.
    USBMSCFS.remove(path);

    File file =
        USBMSCFS.open(
            path,
            FILE_WRITE
        );

    if (!file) {

        server.send(
            500,
            "application/json",
            "{\"ok\":false,\"error\":\"Não foi possível abrir arquivo para escrita\"}"
        );

        return;
    }

    size_t written =
        file.print(content);

    file.close();

    if (written != content.length()) {

        server.send(
            500,
            "application/json",
            "{\"ok\":false,\"error\":\"Falha durante gravação\"}"
        );

        return;
    }

    server.send(
        200,
        "application/json",
        "{\"ok\":true,\"message\":\"Arquivo salvo\"}"
    );
}

