            500,
            "application/json",
            "{\"ok\":false,\"error\":\"Falha ao criar pasta\"}"
        );

    }
}

// ============================================================
// DELETE
// ============================================================

void handleDelete() {

    if (!requireAdmin())
        return;

    String path;

    if (!normalizePath(
            server.arg("path"),
            path
        )) {

        server.send(
            400,
            "application/json",
            "{\"ok\":false,\"error\":\"Path inválido\"}"
        );

        return;
    }

    if (path == "/") {

        server.send(
            400,
            "application/json",
            "{\"ok\":false,\"error\":\"Não é permitido excluir a raiz\"}"
        );

        return;
    }

    File target =
        USBMSCFS.open(path);

    if (!target) {

        server.send(
            404,
            "application/json",
            "{\"ok\":false,\"error\":\"Arquivo ou pasta não encontrado\"}"
        );

        return;
    }

    bool dir =
        target.isDirectory();

    target.close();

    bool success;

    if (dir)
        success =
            USBMSCFS.rmdir(path);
    else
        success =
            USBMSCFS.remove(path);

    if (success) {

        server.send(
            200,
            "application/json",
            "{\"ok\":true,\"message\":\"Excluído\"}"
        );

    }
    else {

        server.send(
            500,
            "application/json",
            "{\"ok\":false,\"error\":\"Falha ao excluir\"}"
        );

    }
}

// ============================================================
// UPLOAD
// ============================================================

void handleUpload(
    HTTPUpload &upload
) {

    if (
        upload.status ==
        UPLOAD_FILE_START
    ) {

        uploadAuthorized =
            server.authenticate(
                ADMIN_USER,
                ADMIN_PASS
            );

        if (!uploadAuthorized) {

            server.requestAuthentication();

            return;
        }

        String dir;

        if (!normalizePath(
                server.arg("dir"),
                dir
            )) {

            uploadAuthorized = false;
            return;
        }

        String filename =
            String(upload.filename);

        filename.replace("\\", "/");

        int slash =
            filename.lastIndexOf('/');

        if (slash >= 0) {

            filename =
                filename.substring(
                    slash + 1
                );

        }

        if (
            filename.length() == 0 ||
            filename == "." ||
            filename == ".."
        ) {

            uploadAuthorized = false;
            return;
        }

        if (dir == "/")
            uploadPath =
                "/" + filename;
        else
            uploadPath =
                dir + "/" + filename;

        String safePath;

        if (!normalizePath(
                uploadPath,
                safePath
            )) {

            uploadAuthorized = false;
            return;
        }

        uploadPath = safePath;

        // Sobrescrever.
        USBMSCFS.remove(
            uploadPath
        );

        uploadFile =
            USBMSCFS.open(
                uploadPath,
                FILE_WRITE
            );

        Serial.println();
        Serial.println(
            "[UPLOAD] " +
            uploadPath
        );
    }

    else if (
        upload.status ==
        UPLOAD_FILE_WRITE
    ) {

        if (
            uploadAuthorized &&
            uploadFile
        ) {

            uploadFile.write(
                upload.buf,
                upload.currentSize
            );

        }
    }

    else if (
        upload.status ==
        UPLOAD_FILE_END
    ) {

        if (uploadFile) {

            uploadFile.close();

        }

        if (uploadAuthorized) {

            Serial.printf(
                "[UPLOAD] concluído: %u bytes\n",
                (unsigned)upload.totalSize
            );

        }

        uploadAuthorized = false;
    }
}

