#!/usr/bin/env python3
import requests, json, time, subprocess, sys, os

API = "http://localhost:3000"
AST_HOST = "pbx.local"

def allocate_did():
    r = requests.post(f"{API}/allocate", json={"country": "BR"})
    return r.json()["did"]

def register_extension(ext="100", secret="s3cr3t"):
    cfg = f"""
[{ext}]
type=auth
auth_type=userpass
password={secret}
username={ext}

[{ext}]
type=aor
max_contacts=1

[{ext}]
type=endpoint
context=from-internal
disallow=all
allow=ulaw
auth=[{ext}]
aors=[{ext}]
"""
    with open("/opt/voip/asterisk/pjsip.d/custom.conf", "w") as f:
        f.write(cfg)
    subprocess.run(["docker", "exec", "voip-asterisk-1", "asterisk", "-rx", "core", "reload"], check=False)
    print(f"Ramal {ext} registrado")

def send_sms(src, dst, body):
    return requests.post(f"{API}/sms/send", json={"src": src, "dst": dst, "text": body}).json()

if __name__ == "__main__":
    did = allocate_did()
    print(f"DID alocado: {did}")
    register_extension("100", "s3cr3t")
    print("Sistema pronto. Use softphone para registrar ramal 100/s3cr3t no IP desta máquina.")
    print(f"Teste SMS: {send_sms(did, '+5511999999999', 'Teste VoIP real')}")
