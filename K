#!/usr/bin/env python3
import requests, json, time, logging, os, sys
from datetime import datetime

WA_API = os.getenv("WA_API_URL", "http://localhost:4444")
SMS_API = os.getenv("SMS_API_URL", "http://localhost:3000")
TOKEN = os.getenv("WA_TOKEN", "verify-token-2026")

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(message)s")

def poll_sms_and_relay():
    """Pega SMS recebido e retransmite para WhatsApp via API"""
    while True:
        try:
            r = requests.get(f"{SMS_API}/sms/+5511999999999", timeout=5)
            if r.status_code == 200:
                msgs = r.json()
                for m in msgs:
                    src = m["src"]
                    txt = m["text"]
                    # Reenvia para WhatsApp (exemplo: grupo ou bot)
                    payload = {
                        "messaging_product": "whatsapp",
                        "to": "SEU_NUMERO_WABA",
                        "type": "text",
                        "text": {"body": f"[SMS {src}] {txt}"}
                    }
                    wh = requests.post(
                        f"https://graph.facebook.com/v18.0/{os.getenv('WA_PHONE_ID')}/messages",
                        headers={"Authorization": f"Bearer {os.getenv('WA_ACCESS_TOKEN')}"},
                        json=payload
                    )
                    logging.info(f"Relayed SMS -> WA: {wh.status_code}")
        except Exception as e:
            logging.error(f"Relay error: {e}")
        time.sleep(10)

if __name__ == "__main__":
    poll_sms_and_relay()
PYEOF
