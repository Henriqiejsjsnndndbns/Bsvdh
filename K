#!/usr/bin/env bash
set -euo pipefail
IFS=\n\t'

# === 1) Requisitos e variáveis ===
export DEBIAN_FRONTEND=noninteractive
TIMEZONE="America/Sao_Paulo"
DOMAIN="pbx.local"
PUBLIC_IP=$(curl -s https://api.ipify.org || echo "127.0.0.1")

# Credenciais (altere para as suas)
SMTP_USER="sip_user"
SMTP_PASS="S1p$2026!"
DB_PASS="V01p$2026!"
RABBIT_PASS="V01p$2026!"

# Provedores (crie conta e substitua)
TWILIO_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_TOKEN="seu_token_twilio"
TWILIO_NUMBER="+5511999999999"
NEXMO_API_KEY="nexmo_key"
NEXMO_API_SECRET="nexmo_secret"
NEXMO_NUMBER="+5511888888888"

# SMPP (ex: Bandwidth/Vonage ou provedor local)
SMPP_HOST="smpp.provider.com"
SMPP_USER="V01P"
SMPP_PASS="SMPP_PASS"
SMPP_SYSTEM_TYPE=""

# === 2) Sistema e rede ===
timedatectl set-timezone "$TIMEZONE"
apt-get update && apt-get upgrade -y
apt-get install -y sudo curl wget git gnupg2 lsb-release apt-transport-https ca-certificates software-properties-common dirmngr cron ufw

# Firewall básico (libera SIP/RTP/Web/TLS)
ufw default deny incoming
ufw default allow outgoing
ufw allow 22/tcp
ufw allow 80/tcp
ufw allow 443/tcp
ufw allow 5060/udp
ufw allow 5061/tcp
ufw allow 10000:20000/udp
ufw --force enable

# === 3) Docker e Docker Compose ===
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null
chmod a+r /etc/apt/keyrings/docker.gpg
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

# === 4) Diretórios e configuração ===
mkdir -p /opt/voip/{asterisk,sms-gateway,scripts,certs}
cd /opt/voip

# === 5) Gerar certificados TLS (autossinados para lab; use Let's Encrypt em prod)
openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
  -keyout /opt/voip/certs/asterisk.key \
  -out /opt/voip/certs/asterisk.crt \
  -subj "/CN=${DOMAIN}"

# === 6) docker-compose.yml ===
