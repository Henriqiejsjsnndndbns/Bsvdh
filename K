cat > /opt/voip/sms-gateway/app.py <<'PYEOF'
import os, json, time, threading, subprocess, logging
from flask import Flask, request, jsonify
import requests, smpplib, pika, psycopg2
from datetime import datetime

app = Flask(__name__)
logging.basicConfig(level=logging.INFO)

# Config
DB_URL = os.getenv("DB_URL")
RABBIT_URL = os.getenv("RABBITMQ_URL")
TWILIO_SID = os.getenv("TWILIO_SID")
TWILIO_TOKEN = os.getenv("TWILIO_TOKEN")
TWILIO_NUMBER = os.getenv("TWILIO_NUMBER")
NEXMO_KEY = os.getenv("NEXMO_API_KEY")
NEXMO_SECRET = os.getenv("NEXMO_API_SECRET")
NEXMO_NUMBER = os.getenv("NEXMO_NUMBER")
SMPP_HOST = os.getenv("SMPP_HOST")
SMPP_USER = os.getenv("SMPP_USER")
SMPP_PASS = os.getenv("SMPP_PASS")
SMPP_TYPE = os.getenv("SMPP_SYSTEM_TYPE", "")

# DB init
def get_conn():
    return psycopg2.connect(DB_URL)

def init_db():
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("""
                CREATE TABLE IF NOT EXISTS numbers(
                    id SERIAL PRIMARY KEY,
                    did VARCHAR(20) UNIQUE,
                    country VARCHAR(2),
                    status VARCHAR(10),
                    created_at TIMESTAMP DEFAULT NOW()
                );
                CREATE TABLE IF NOT EXISTS sms(
                    id SERIAL PRIMARY KEY,
                    src VARCHAR(20),
                    dst VARCHAR(20),
                    text TEXT,
                    ts TIMESTAMP DEFAULT NOW()
                );
            """)
        conn.commit()

init_db()

# RabbitMQ
def rabbit_publish(queue, body):
    try:
        conn = pika.BlockingConnection(pika.URLParameters(RABBIT_URL))
        ch = conn.channel()
        ch.queue_declare(queue=queue, durable=True)
        ch.basic_publish(exchange='', routing_key=queue, body=json.dumps(body))
        conn.close()
    except Exception as e:
        logging.error(f"Rabbit publish error: {e}")

# SMPP
smpp_conn = None
def smpp_start():
    global smpp_conn
    try:
        smpp_conn = smpplib.client.Client(SMPP_HOST, 2775)
        smpp_conn.set_message_received_handler(lambda pdu: on_sms_deliver(pdu))
        smpp_conn.connect()
        smpp_conn.bind_transceiver(system_id=SMPP_USER, password=SMPP_PASS, system_type=SMPP_TYPE)
        logging.info("SMPP conectado")
    except Exception as e:
        logging.error(f"SMPP erro: {e}")

def on_sms_deliver(pdu):
    src = pdu.source_addr
    dst = pdu.destination_addr
    txt = pdu.short_message.message if isinstance(pdu.short_message.message, str) else pdu.short_message.message.decode()
    logging.info(f"SMPP SMS recebido: {src} -> {dst} | {txt}")
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("INSERT INTO sms(src,dst,text) VALUES(%s,%s,%s)", (src, dst, txt))
        conn.commit()
    rabbit_publish("sms.in", {"src": src, "dst": dst, "text": txt})

# Rotas API
@app.route("/allocate", methods=["POST"])
def allocate():
    country = request.json.get("country", "BR") if request.json else "BR"
    # Compra/renta DID via Twilio (exemplo)
    try:
        r = requests.post(
            f"https://api.twilio.com/2010-04-01/Accounts/{TWILIO_SID}/IncomingPhoneNumbers.json",
            auth=(TWILIO_SID, TWILIO_TOKEN),
            data={"PhoneNumber": TWILIO_NUMBER}
        )
        if r.status_code not in (200, 201):
            logging.warning("Twilio create failed, fallback random")
            did = f"+5511{10000000 + (hash(str(time.time())) % 90000000)}"
        else:
            did = r.json().get("phone_number", TWILIO_NUMBER)
    except Exception as e:
        logging.error(f"Twilio error: {e}")
        did = f"+5511{10000000 + (hash(str(time.time())) % 90000000)}"

    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("INSERT INTO numbers(did,country,status) VALUES(%s,%s,%s) ON CONFLICT DO NOTHING", (did, country, "active"))
        conn.commit()
    return jsonify({"did": did})

@app.route("/sms/<did>", methods=["GET"])
def get_sms(did):
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("SELECT src,text,ts FROM sms WHERE dst=%s ORDER BY ts DESC LIMIT 20", (did,))
            rows = [{"src": r[0], "text": r[1], "ts": r[2].isoformat()} for r in cur.fetchall()]
    return jsonify(rows)

@app.route("/sms/send", methods=["POST"])
def send_sms():
    data = request.json or {}
    src, dst, text = data.get("src"), data.get("dst"), data.get("text")
    # Envia via SMPP (exemplo)
    if smpp_conn and smpp_conn.smpp_state == smpplib.consts.SMPP_CLIENT_STATE_BOUND_TRX:
        smpp_conn.send_message(
            source_addr=src,
            destination_addr=dst,
            short_message=text,
            data_coding=0
        )
        logging.info(f"SMPP SMS enviado: {src} -> {dst}")
    return jsonify({"status": "sent"})

if __name__ == "__main__":
    # Start SMPP thread
    t = threading.Thread(target=smpp_start, daemon=True)
    t.start()
    app.run(host="0.0.0.0", port=3000)
PYEOF

